  "syntheticInput": {
    "userPrompt": "Format cells with fill color",
    "workbookContext": {
      "activeSheet": "Sheet1",
      "selectedRange": "A1:A10"
    }
  },
  "modelOutput": {
    "tool_calls": [
      {
        "id": "call_003",
        "type": "function",
        "function": {
          "name": "format_range",
          "arguments": "{\"sheet\": \"Sheet1\", \"address\": \"A1:A10\", \"fill_color\": \"#FF0000\", \"font_color\": \"#FFFFFF\"}"
        }
      }
    ]
  },
  "expectedDisposition": "rejected-syntax-alias",
  "failureClass": "command-drift",
  "notes": "Uses snake_case 'fill_color' and 'font_color' instead of camelCase 'fillColor' and 'fontColor'"
}
